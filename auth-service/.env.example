# 谷子 Auth Service
AUTH_ADDR=:8081

# 微信小程序
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 用于从 openid 派生 core_user 内部密码（HMAC 密钥，请使用随机长字符串）
AUTH_PASSWORD_SECRET=

# CRV Service（public_api v1.4 · session 模式）
CRV_BASE_URL=http://127.0.0.1:8080
CRV_APPID=gushi

# provisioner：同步 core_user 用的长期集成令牌（int_ 前缀，由 CRV 管理员签发）
CRV_PROVISIONER_TOKEN=

# 代用户登录 CRV 时 username 对应 core_user 哪一列（id | user_name_en | user_name_zh）
CRV_LOGIN_USERNAME_FIELD=id

DEFAULT_USER_ROLE=gushi_user
