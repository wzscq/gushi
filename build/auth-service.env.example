# Auth Service Docker 运行环境变量样本
# 用法：
#   cp build/auth-service.env.example auth-service.env
#   填写密钥后：./build/docker-run-auth.sh 1.0.0
#
# 或指定文件：
#   ./build/docker-run-auth.sh 1.0.0 /path/to/your.env

AUTH_ADDR=:8081

# 微信小程序
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 从 openid 派生 core_user 内部密码的 HMAC 密钥（请使用随机长字符串）
AUTH_PASSWORD_SECRET=

# CRV Service
# 注意：在 Docker 容器内不要用 http://127.0.0.1:8080（那是容器自己）
# 请改为宿主机可达地址，例如：
#   http://172.17.0.1:8080
#   http://host.docker.internal:8080
#   http://<宿主机局域网IP>:8080
CRV_BASE_URL=http://172.17.0.1:8080
CRV_APPID=gushi

# CRV 管理员签发的长期集成令牌（int_ 前缀）
CRV_PROVISIONER_TOKEN=

# 代用户登录 CRV 时 username 对应 core_user 列
CRV_LOGIN_USERNAME_FIELD=id

DEFAULT_USER_ROLE=gushi_user
