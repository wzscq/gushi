.form-page {
  padding: 24rpx 24rpx 48rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.loading {
  padding: 120rpx 0;
  text-align: center;
  color: var(--muted);
}

.photo-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--muted);
  font-size: 28rpx;
  background: #faf7fb;
}

.section {
  background: var(--card);
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--card-border);
  box-shadow: 0 8rpx 24rpx rgba(44, 42, 50, 0.04);
}

.section-title {
  font-size: 28rpx;
  font-weight: 650;
  margin-bottom: 16rpx;
  color: var(--text);
}

.photos {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
  background: #faf7fb;
}

.photo image {
  width: 100%;
  height: 100%;
}

.photo.add {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed rgba(232, 90, 122, 0.35);
  background: var(--accent-soft);
  font-size: 56rpx;
  color: var(--accent);
}

.photo-del {
  position: absolute;
  top: 0;
  right: 0;
  width: 44rpx;
  height: 44rpx;
  background: rgba(44, 42, 50, 0.45);
  color: #ffffff;
  text-align: center;
  line-height: 44rpx;
  font-size: 28rpx;
}

.field {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f3eef2;
}

.field:last-child {
  border-bottom: none;
}

.label {
  width: 160rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  color: var(--muted);
}

.input,
.picker {
  flex: 1;
  font-size: 28rpx;
  color: var(--text);
}

.picker {
  text-align: right;
  color: var(--text);
}

.textarea {
  width: 100%;
  min-height: 160rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  background: #faf7fb;
  border-radius: 16rpx;
  padding: 16rpx;
}

.actions {
  display: flex;
  gap: 24rpx;
  margin-top: 16rpx;
}

.btn-cancel,
.btn-save {
  flex: 1;
  border-radius: 24rpx;
  font-size: 30rpx;
}

.btn-cancel {
  background: var(--card);
  color: var(--muted);
  border: 1rpx solid var(--card-border);
}

.btn-cancel::after {
  border: none;
}

.btn-save {
  background: var(--accent);
  color: #ffffff;
}

.btn-save::after {
  border: none;
}
