.detail-page {
  min-height: 100vh;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.state {
  padding: 120rpx 32rpx;
  text-align: center;
}

.retry {
  margin-top: 32rpx;
}

.gallery {
  position: relative;
  width: 100%;
  height: 750rpx;
  background: linear-gradient(180deg, #2a2430 0%, #1c1820 100%);
}

.swiper {
  width: 100%;
  height: 100%;
}

.slide {
  width: 100%;
  height: 100%;
}

.gallery-empty {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #ffe8ef 0%, #e8f6f3 100%);
  color: var(--accent);
  font-size: 120rpx;
  font-weight: 600;
}

.gallery-count {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  background: rgba(0, 0, 0, 0.45);
  color: #ffffff;
  font-size: 22rpx;
}

.section {
  margin: 24rpx;
  padding: 28rpx 32rpx;
  background: var(--card);
  border-radius: 24rpx;
  border: 1rpx solid var(--card-border);
  box-shadow: 0 8rpx 24rpx rgba(44, 42, 50, 0.04);
}

.section-muted {
  background: #faf7fb;
}

.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--muted);
  margin-bottom: 8rpx;
}

.title-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.title {
  flex: 1;
  min-width: 0;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.3;
  color: var(--text);
}

.update-time {
  flex-shrink: 0;
  max-width: 280rpx;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.3;
  text-align: right;
}

.meta {
  font-size: 26rpx;
  color: var(--muted);
  margin-bottom: 20rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  font-size: 22rpx;
  color: var(--mint);
  background: var(--mint-soft);
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
}

.chip-status {
  color: var(--accent);
  background: var(--accent-soft);
}

.row {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f3eef2;
}

.row:last-child {
  border-bottom: none;
}

.label {
  width: 140rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--muted);
}

.value {
  flex: 1;
  font-size: 28rpx;
  color: var(--text);
  word-break: break-all;
}

.tags-row .tags {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  font-size: 22rpx;
  color: var(--muted);
  background: #faf7fb;
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
}

.note {
  padding-top: 16rpx;
}

.note-text {
  display: block;
  margin-top: 12rpx;
  font-size: 28rpx;
  color: var(--text);
  line-height: 1.5;
  white-space: pre-wrap;
}

.listing-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f3eef2;
}

.listing-row:last-child {
  border-bottom: none;
}

.listing-main {
  flex: 1;
  min-width: 0;
}

.listing-title {
  display: block;
  font-size: 28rpx;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.listing-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.listing-price {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--accent);
}

.listing-arrow {
  flex-shrink: 0;
  margin-left: 8rpx;
  font-size: 32rpx;
  color: #d0ccd6;
}

.actions {
  display: flex;
  gap: 16rpx;
  margin: 8rpx 24rpx 0;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.btn-sell,
.btn-edit,
.btn-delete {
  flex: 1;
  border-radius: 24rpx;
  font-size: 28rpx;
  padding: 0;
  line-height: 80rpx;
}

.btn-sell {
  background: var(--mint);
  color: #ffffff;
}

.btn-sell::after {
  border: none;
}

.btn-edit {
  background: var(--accent);
  color: #ffffff;
}

.btn-edit::after {
  border: none;
}

.btn-delete {
  background: var(--card);
  color: var(--danger);
  border: 1rpx solid rgba(232, 90, 122, 0.35);
}

.btn-delete::after {
  border: none;
}
