<view class="container">
  <view class="profile-card" bindtap="goProfile">
    <image
      wx:if="{{avatarSrc}}"
      class="avatar-img"
      src="{{avatarSrc}}"
      mode="aspectFill"
      binderror="onAvatarError"
    />
    <view wx:else class="avatar">{{user.nickname ? user.nickname[0] : '我'}}</view>
    <view class="info">
      <text class="nickname">{{user.nickname || '收藏家'}}</text>
      <text class="uid">ID: {{user.id || '—'}}</text>
    </view>
    <text class="arrow">›</text>
  </view>

  <view class="menu">
    <view class="menu-item" bindtap="goSettings">
      <text>设置</text>
      <text class="arrow">›</text>
    </view>
  </view>
</view>
