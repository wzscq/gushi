.profile-edit {
  padding-bottom: 48rpx;
}

.card {
  background: var(--card);
  border-radius: 28rpx;
  padding: 40rpx 32rpx 32rpx;
  border: 1rpx solid var(--card-border);
  box-shadow: 0 10rpx 28rpx rgba(232, 90, 122, 0.08);
  background-image: linear-gradient(135deg, #fff 0%, #fff6f8 100%);
  margin-bottom: 40rpx;
}

.avatar-btn {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 200rpx;
  padding: 0;
  margin: 0 auto 36rpx;
  background: transparent;
  border: none;
  line-height: 1;
  overflow: visible;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  background: #f3eef2;
  border: 3rpx solid rgba(232, 90, 122, 0.25);
  display: block;
  margin: 0 auto;
  box-sizing: border-box;
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #e85a7a 0%, #f08aa0 100%);
  color: #ffffff;
  font-size: 56rpx;
  font-weight: 600;
  line-height: 1;
}

.avatar-hint {
  display: block;
  width: 100%;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--muted);
  text-align: center;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.label {
  font-size: 26rpx;
  color: var(--muted);
}

.nickname-input {
  width: 100%;
  height: 88rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  background: #fff;
  border-radius: 20rpx;
  border: 1rpx solid var(--card-border);
  font-size: 30rpx;
  color: var(--text);
}

.save-btn {
  width: 100%;
  border-radius: 28rpx;
  font-size: 32rpx;
  line-height: 96rpx;
  background: var(--accent);
  color: #ffffff;
  border: none;
  box-shadow: 0 12rpx 28rpx rgba(232, 90, 122, 0.28);
}

.save-btn::after {
  border: none;
}

.save-btn[disabled] {
  opacity: 0.7;
}

.error {
  display: block;
  margin-top: 24rpx;
  text-align: center;
  color: var(--danger);
  font-size: 26rpx;
}
