.form-page {
  padding: 24rpx 24rpx 48rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.loading {
  padding: 120rpx 0;
  text-align: center;
}

.section {
  background: var(--card);
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--card-border);
}

.section-title {
  font-size: 28rpx;
  font-weight: 650;
  margin-bottom: 16rpx;
  color: var(--text);
}

.import-btn {
  margin-top: 20rpx;
  background: var(--accent-soft);
  color: var(--accent);
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 80rpx;
  border: none;
}

.import-btn::after {
  border: none;
}

.source-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 8rpx;
}

.hint {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.5;
}

.photos {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
  background: #faf7fb;
}

.photo image {
  width: 100%;
  height: 100%;
}

.photo.add {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed rgba(232, 90, 122, 0.35);
  background: var(--accent-soft);
  font-size: 56rpx;
  color: var(--accent);
}

.photo-empty {
  padding: 24rpx 0;
  font-size: 26rpx;
  line-height: 1.5;
}

.photo-del {
  position: absolute;
  top: 0;
  right: 0;
  width: 44rpx;
  height: 44rpx;
  background: rgba(44, 42, 50, 0.45);
  color: #ffffff;
  text-align: center;
  line-height: 44rpx;
  font-size: 28rpx;
}

.photo-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--muted);
  background: #faf7fb;
}

.field {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  border-top: 1rpx solid #f3eef2;
}

.field:first-of-type {
  border-top: none;
}

.label {
  width: 140rpx;
  flex-shrink: 0;
  color: var(--muted);
  font-size: 28rpx;
}

.input,
.picker {
  flex: 1;
  font-size: 28rpx;
  color: var(--text);
}

.save-btn {
  margin-top: 8rpx;
}

.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(44, 42, 50, 0.4);
  z-index: 20;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 70vh;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  z-index: 21;
  transform: translateY(110%);
  transition: transform 0.25s ease;
  padding-bottom: env(safe-area-inset-bottom);
}

.sheet.open {
  transform: translateY(0);
}

.sheet-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f3eef2;
}

.sheet-title {
  font-size: 30rpx;
  font-weight: 600;
}

.sheet-close {
  font-size: 28rpx;
  color: var(--accent);
}

.import-list {
  max-height: 56vh;
  padding: 0 32rpx 24rpx;
  box-sizing: border-box;
}

.import-state {
  padding: 48rpx 0;
  text-align: center;
}

.import-row {
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f3eef2;
}

.import-name {
  display: block;
  font-size: 30rpx;
  color: var(--text);
}

.import-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--muted);
}
