.tabs {
  display: flex;
  background: var(--card);
  border-radius: 24rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--card-border);
}

.tab {
  flex: 1;
  text-align: center;
  height: 68rpx;
  line-height: 68rpx;
  font-size: 28rpx;
  color: var(--muted);
  border-radius: 18rpx;
}

.tab.active {
  color: #fff;
  background: var(--accent);
  font-weight: 600;
}

.toolbar {
  margin-bottom: 16rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  height: 76rpx;
  background: var(--card);
  border-radius: 24rpx;
  border: 1rpx solid var(--card-border);
  box-sizing: border-box;
}

.search-input {
  flex: 1;
  height: 76rpx;
  font-size: 28rpx;
  color: var(--text);
}

.search-clear {
  width: 44rpx;
  height: 44rpx;
  margin-left: 8rpx;
  border-radius: 50%;
  background: var(--accent-soft);
  color: var(--accent);
  font-size: 32rpx;
  line-height: 44rpx;
  text-align: center;
}

.state {
  padding: 80rpx 0;
  text-align: center;
}

.retry {
  margin-top: 32rpx;
}

.empty {
  padding: 80rpx 32rpx;
  text-align: center;
}

.empty-illust {
  width: 280rpx;
  height: 280rpx;
  margin: 0 auto 24rpx;
  display: block;
}

.empty-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: var(--text);
}

.grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -12rpx;
  padding-bottom: 48rpx;
}

.card {
  width: 50%;
  box-sizing: border-box;
  padding: 0 12rpx;
  margin-bottom: 28rpx;
}

.cover-wrap {
  width: 100%;
  padding-top: 100%;
  position: relative;
  border-radius: 24rpx;
  overflow: hidden;
  background: #efeaf4;
  border: 1rpx solid var(--card-border);
}

.cover {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.cover.placeholder {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #ffe8ef 0%, #e8f6f3 100%);
  color: var(--accent);
  font-size: 64rpx;
  font-weight: 600;
}

.badge {
  position: absolute;
  left: 12rpx;
  top: 12rpx;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  background: rgba(44, 42, 50, 0.72);
  color: #fff;
  font-size: 20rpx;
}

.name {
  display: block;
  margin-top: 14rpx;
  padding: 0 6rpx;
  font-size: 26rpx;
  color: var(--text);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.price {
  display: block;
  margin-top: 6rpx;
  padding: 0 6rpx;
  font-size: 28rpx;
  color: var(--accent);
  font-weight: 700;
}

.meta {
  display: block;
  margin-top: 4rpx;
  padding: 0 6rpx;
  font-size: 20rpx;
  color: var(--muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
