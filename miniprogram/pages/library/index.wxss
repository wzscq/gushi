.toolbar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.search-bar {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  height: 76rpx;
  background: var(--card);
  border-radius: 24rpx;
  border: 1rpx solid var(--card-border);
  box-sizing: border-box;
  box-shadow: 0 6rpx 18rpx rgba(44, 42, 50, 0.04);
}

.search-input {
  flex: 1;
  height: 76rpx;
  font-size: 28rpx;
  color: var(--text);
}

.search-clear {
  width: 44rpx;
  height: 44rpx;
  margin-left: 8rpx;
  border-radius: 50%;
  background: var(--accent-soft);
  color: var(--accent);
  font-size: 32rpx;
  line-height: 44rpx;
  text-align: center;
}

.filter-btn {
  position: relative;
  flex-shrink: 0;
  height: 76rpx;
  padding: 0 28rpx;
  line-height: 76rpx;
  font-size: 28rpx;
  color: var(--muted);
  background: var(--card);
  border-radius: 24rpx;
  border: 1rpx solid var(--card-border);
}

.filter-btn.active {
  color: var(--accent);
  background: var(--accent-soft);
  border-color: transparent;
}

.filter-dot {
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--accent);
}

.meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 0 8rpx;
}

.meta-total {
  font-size: 24rpx;
  color: var(--muted);
}

.meta-clear {
  font-size: 24rpx;
  color: var(--accent);
}

.state {
  padding: 80rpx 0;
  text-align: center;
}

.retry {
  margin-top: 32rpx;
}

.empty {
  padding: 80rpx 32rpx;
  text-align: center;
}

.empty-illust {
  width: 320rpx;
  height: 320rpx;
  margin: 0 auto 24rpx;
  display: block;
}

.empty-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: var(--text);
}

.empty-btn {
  margin-top: 48rpx;
}

.btn-clear-search {
  margin-top: 24rpx;
  background: transparent;
  color: var(--accent);
  font-size: 28rpx;
}

.btn-clear-search::after {
  border: none;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -12rpx;
  padding-bottom: 160rpx;
}

.card {
  width: 50%;
  box-sizing: border-box;
  padding: 0 12rpx;
  margin-bottom: 28rpx;
}

.cover-wrap {
  width: 100%;
  padding-top: 100%;
  position: relative;
  border-radius: 24rpx;
  overflow: hidden;
  background: #efeaf4;
  border: 1rpx solid var(--card-border);
  box-shadow: 0 10rpx 24rpx rgba(44, 42, 50, 0.06);
}

.cover {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.cover.placeholder {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #ffe8ef 0%, #e8f6f3 100%);
  color: var(--accent);
  font-size: 64rpx;
  font-weight: 600;
}

.name {
  display: block;
  margin-top: 14rpx;
  padding: 0 6rpx;
  font-size: 26rpx;
  color: var(--text);
  font-weight: 500;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.update-time {
  display: block;
  margin-top: 6rpx;
  padding: 0 6rpx;
  font-size: 20rpx;
  color: var(--muted);
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: var(--accent);
  color: #ffffff;
  font-size: 56rpx;
  line-height: 100rpx;
  text-align: center;
  box-shadow: 0 12rpx 28rpx rgba(232, 90, 122, 0.35);
  z-index: 10;
}

/* 筛选弹层 */
.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(44, 42, 50, 0.35);
  z-index: 100;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 75vh;
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.25s ease;
  display: flex;
  flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
}

.sheet:not(.open) {
  pointer-events: none;
}

.sheet.open {
  transform: translateY(0);
}

.sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 16rpx;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}

.sheet-close {
  font-size: 28rpx;
  color: var(--muted);
}

.sheet-body {
  flex: 1;
  max-height: 52vh;
  padding: 8rpx 32rpx 24rpx;
  box-sizing: border-box;
}

.sheet-section {
  margin-bottom: 32rpx;
}

.sheet-label {
  font-size: 26rpx;
  color: var(--muted);
  margin-bottom: 16rpx;
}

.sheet-input {
  height: 72rpx;
  padding: 0 24rpx;
  background: #faf7fb;
  border-radius: 16rpx;
  font-size: 28rpx;
  border: 1rpx solid var(--card-border);
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: var(--muted);
  background: #faf7fb;
  border-radius: 16rpx;
  border: 1rpx solid transparent;
}

.chip.selected {
  color: var(--accent);
  background: var(--accent-soft);
  border-color: rgba(232, 90, 122, 0.2);
}

.sheet-footer {
  display: flex;
  gap: 24rpx;
  padding: 16rpx 32rpx 24rpx;
  border-top: 1rpx solid #f3eef2;
}

.sheet-btn {
  flex: 1;
  border-radius: 24rpx;
  font-size: 30rpx;
}

.sheet-btn.reset {
  background: #faf7fb;
  color: var(--muted);
}

.sheet-btn.reset::after {
  border: none;
}

.sheet-btn.confirm {
  background: var(--accent);
  color: #ffffff;
}

.sheet-btn.confirm::after {
  border: none;
}
