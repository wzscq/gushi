.login-page {
  position: relative;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 48rpx 48rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.decor {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.decor-a {
  width: 360rpx;
  height: 360rpx;
  top: -80rpx;
  right: -100rpx;
  background: radial-gradient(circle, rgba(232, 90, 122, 0.18) 0%, transparent 70%);
}

.decor-b {
  width: 420rpx;
  height: 420rpx;
  bottom: 120rpx;
  left: -160rpx;
  background: radial-gradient(circle, rgba(92, 184, 168, 0.16) 0%, transparent 70%);
}

.hero {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 64rpx;
}

.title {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--text);
  letter-spacing: 4rpx;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: var(--muted);
}

.actions {
  position: relative;
  z-index: 1;
  width: 100%;
}

.login-btn {
  width: 100%;
  border-radius: 28rpx;
  font-size: 32rpx;
  line-height: 96rpx;
  background: var(--accent);
  color: #ffffff;
  border: none;
  box-shadow: 0 12rpx 28rpx rgba(232, 90, 122, 0.28);
}

.login-btn::after {
  border: none;
}

.error {
  display: block;
  margin-top: 24rpx;
  text-align: center;
  color: var(--danger);
  font-size: 26rpx;
}

.footer {
  position: relative;
  z-index: 1;
  margin-top: auto;
  padding-top: 80rpx;
}

.privacy {
  font-size: 24rpx;
  color: var(--muted);
  text-align: center;
  line-height: 1.6;
}

.profile {
  position: relative;
  z-index: 1;
  width: 100%;
  margin-bottom: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-btn {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 200rpx;
  padding: 0;
  margin: 0 auto 28rpx;
  background: transparent;
  border: none;
  line-height: 1;
  overflow: visible;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  background: #f3eef2;
  border: 3rpx solid rgba(232, 90, 122, 0.25);
  display: block;
  margin: 0 auto;
  box-sizing: border-box;
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--accent-soft);
  color: var(--accent);
  font-size: 56rpx;
  font-weight: 300;
  line-height: 1;
}

.avatar-hint {
  display: block;
  width: 100%;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--muted);
  text-align: center;
}

.nickname-input {
  width: 100%;
  height: 80rpx;
  padding: 0 28rpx;
  background: var(--card);
  border-radius: 20rpx;
  text-align: center;
  border: 1rpx solid var(--card-border);
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 80rpx;
  overflow: hidden;
}
