.login-page {
  position: relative;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 48rpx 48rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.decor {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.decor-a {
  width: 360rpx;
  height: 360rpx;
  top: -80rpx;
  right: -100rpx;
  background: radial-gradient(circle, rgba(232, 90, 122, 0.18) 0%, transparent 70%);
}

.decor-b {
  width: 420rpx;
  height: 420rpx;
  bottom: 120rpx;
  left: -160rpx;
  background: radial-gradient(circle, rgba(92, 184, 168, 0.16) 0%, transparent 70%);
}

.hero {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 100rpx;
}

.logo-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 40rpx;
  margin-bottom: 36rpx;
  border: 2rpx solid rgba(232, 90, 122, 0.15);
  box-shadow: 0 16rpx 40rpx rgba(232, 90, 122, 0.18);
}

.title {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--text);
  letter-spacing: 4rpx;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: var(--muted);
}

.actions {
  position: relative;
  z-index: 1;
  width: 100%;
}

.login-btn {
  width: 100%;
  border-radius: 28rpx;
  font-size: 32rpx;
  line-height: 96rpx;
  background: var(--accent);
  color: #ffffff;
  border: none;
  box-shadow: 0 12rpx 28rpx rgba(232, 90, 122, 0.28);
}

.login-btn::after {
  border: none;
}

.error {
  display: block;
  margin-top: 24rpx;
  text-align: center;
  color: var(--danger);
  font-size: 26rpx;
}

.footer {
  position: relative;
  z-index: 1;
  margin-top: auto;
  padding-top: 80rpx;
}

.privacy {
  font-size: 24rpx;
  color: var(--muted);
  text-align: center;
  line-height: 1.6;
}

.profile {
  width: 100%;
  margin-bottom: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-btn {
  padding: 0;
  background: transparent;
  border: none;
  margin-bottom: 24rpx;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #eeeeee;
}

.nickname-input {
  width: 100%;
  padding: 20rpx 24rpx;
  background: var(--card);
  border-radius: 20rpx;
  text-align: center;
  border: 1rpx solid var(--card-border);
}
